# Copy this file to .env and adjust for your machine.

DATABASE_URL=sqlite:///./polaris.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Path to the IAVNS dataset bundle (AMSR2, GEBCO, ERA5, GLORYS, Sentinel-1,
# BYU MERS). May be relative (resolved against backend/) or absolute.
# Examples:
#   IAVNS_DATA_DIR=./DataSets
#   IAVNS_DATA_DIR=/data/iavns/DataSets
#   IAVNS_DATA_DIR=D:\IAVNS\DataSets
IAVNS_DATA_DIR=./DataSets

SECRET_KEY=dev-secret-key-change-in-production
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_VERSION=v1
