import React, { useEffect, useRef, useCallback } from 'react'
import Map from 'ol/Map'
import View from 'ol/View'
import TileLayer from 'ol/layer/Tile'
import VectorLayer from 'ol/layer/Vector'
import VectorSource from 'ol/source/Vector'
import XYZ from 'ol/source/XYZ'
import { Feature } from 'ol'
import { Point, LineString, Polygon } from 'ol/geom'
import { Style, Stroke, Fill, Circle, Text } from 'ol/style'
import { fromLonLat } from 'ol/proj'
import { register } from 'ol/proj/proj4'
import proj4 from 'proj4'
import styles from './MapView.module.css'

proj4.defs('EPSG:3031', '+proj=stere +lat_0=-90 +lon_0=0 +k=1 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs')
register(proj4)

export type RouteType = 'FASTEST' | 'SAFEST' | 'BALANCED'

export interface MapViewProps {
  selectedRoute?: RouteType
  forecastFrame?: string
}

const ROUTE_COLORS = {
  FASTEST: '#f5a623',
  SAFEST: '#27ae60',
  BALANCED: '#bdc3c7',
}

const GEOGRAPHIC_LABELS = [
  { text: 'ANTARCTIC PENINSULA', lon: -58, lat: -68 },
  { text: 'WEDDELL SEA', lon: 10, lat: -72 },
  { text: 'SCOTT SEA', lon: 45, lat: -80 },
  { text: 'ROSS ICE SHELF', lon: 160, lat: -82 },
  { text: 'BELLINGSHAUSEN SEA', lon: -70, lat: -72 },
]

const FAKE_VESSEL = {
  longitude: 45.315,
  latitude: -70.359,
  heading: 132.6,
}

const FAKE_ROUTES = [
  {
    type: 'FASTEST' as const,
    coordinates: [
      [45.315, -70.359],
      [44.8, -71],
      [44.1, -71.55],
      [43.2, -72.05],
      [42.4, -72.25],
    ],
  },
  {
    type: 'SAFEST' as const,
    coordinates: [
      [45.315, -70.359],
      [46.25, -70.95],
      [46, -71.7],
      [44.7, -72.45],
      [42.4, -72.25],
    ],
  },
  {
    type: 'BALANCED' as const,
    coordinates: [
      [45.315, -70.359],
      [45.45, -71.12],
      [44.85, -71.8],
      [43.8, -72.22],
      [42.4, -72.25],
    ],
  },
]

const FAKE_ICEBERGS = [
  {
    id: 'IBG-001',
    longitude: 45.7,
    latitude: -70.2,
    size: 'LARGE',
    confidence: 98,
  },
  {
    id: 'IBG-002',
    longitude: 44.5,
    latitude: -71.1,
    size: 'MEDIUM',
    confidence: 95,
  },
  {
    id: 'IBG-003',
    longitude: 43.8,
    latitude: -71.8,
    size: 'SMALL',
    confidence: 87,
  },
  {
    id: 'IBG-004',
    longitude: 44.2,
    latitude: -70.9,
    size: 'UNCONFIRMED',
    confidence: 62,
  },
]

const FAKE_DANGER_ZONES = [
  {
    id: 'DZ-001',
    name: 'Heavy Ice Concentration',
    vertices: [
      { lon: 34, lat: -62 },
      { lon: 42, lat: -62 },
      { lon: 43, lat: -66 },
      { lon: 33, lat: -67 },
    ],
    riskLevel: 'HIGH',
  },
  {
    id: 'DZ-002',
    name: 'Iceberg Field',
    vertices: [
      { lon: 50, lat: -64 },
      { lon: 58, lat: -63 },
      { lon: 59, lat: -68 },
      { lon: 49, lat: -69 },
    ],
    riskLevel: 'CRITICAL',
  },
]

const MapView: React.FC<MapViewProps> = ({
  selectedRoute = 'BALANCED',
}) => {
  const mapContainerRef = useRef<HTMLDivElement>(null)
  const mapRef = useRef<Map | null>(null)

  const gridSourceRef = useRef<VectorSource>(new VectorSource())
  const labelsSourceRef = useRef<VectorSource>(new VectorSource())
  const vesselSourceRef = useRef<VectorSource>(new VectorSource())
  const routesSourceRef = useRef<VectorSource>(new VectorSource())
  const icebergsSourceRef = useRef<VectorSource>(new VectorSource())
  const dangerZonesSourceRef = useRef<VectorSource>(new VectorSource())
  const iceSourceRef = useRef<VectorSource>(new VectorSource())
  const currentsSourceRef = useRef<VectorSource>(new VectorSource())

  const createGridLines = useCallback(() => {
    const source = gridSourceRef.current
    source.clear()

    for (let lat = -90; lat <= -60; lat += 5) {
      const coords: [number, number][] = []
      for (let lon = -180; lon <= 180; lon += 5) {
        coords.push([lon, lat])
      }
      const line = new Feature({
        geometry: new LineString(coords.map((c) => fromLonLat(c, 'EPSG:3031'))),
      })
      line.setStyle(
        new Style({
          stroke: new Stroke({ color: 'rgba(255,255,255,0.18)', width: 0.5, lineDash: [5, 8] }),
        })
      )
      source.addFeature(line)
    }

    for (let lon = -180; lon <= 180; lon += 30) {
      const coords: [number, number][] = []
      for (let lat = -90; lat <= -60; lat += 1) {
        coords.push([lon, lat])
      }
      const line = new Feature({
        geometry: new LineString(coords.map((c) => fromLonLat(c, 'EPSG:3031'))),
      })
      line.setStyle(
        new Style({
          stroke: new Stroke({ color: 'rgba(255,255,255,0.18)', width: 0.5, lineDash: [5, 8] }),
        })
      )
      source.addFeature(line)
    }
  }, [])

  const createLabels = useCallback(() => {
    const source = labelsSourceRef.current
    source.clear()

    GEOGRAPHIC_LABELS.forEach((label) => {
      const feature = new Feature({
        geometry: new Point(fromLonLat([label.lon, label.lat], 'EPSG:3031')),
      })

      let font = '10px "Courier New", monospace'
      let fill = new Fill({ color: '#4a6a8a' })
      if (label.text === 'WEDDELL SEA') {
        font = 'bold italic 14px "Courier New", monospace'
        fill = new Fill({ color: 'rgba(170,205,235,0.55)' })
        // Canvas API has letterSpacing from Chrome 93, but we can't easily polyfill in OL text style. This uses font only.
      } else if (label.text === 'ANTARCTIC PENINSULA') {
        font = 'italic 11px "Courier New", monospace'
        fill = new Fill({ color: 'rgba(210,190,160,0.55)' })
      }

      feature.setStyle(
        new Style({
          text: new Text({
            text: label.text,
            font: font,
            fill: fill,
            offsetY: 10,
          }),
        })
      )
      source.addFeature(feature)
    })
  }, [])

  const createIcePatches = useCallback(() => {
    const source = iceSourceRef.current
    source.clear()

    // Create ice concentration patches around Antarctica
    const icePatches = [
      { lon: 45, lat: -70, concentration: 0.85, radiusDeg: 3 },
      { lon: 42, lat: -71.5, concentration: 0.75, radiusDeg: 2.5 },
      { lon: 48, lat: -69, concentration: 0.65, radiusDeg: 2 },
      { lon: 40, lat: -73, concentration: 0.90, radiusDeg: 3.5 },
      { lon: 50, lat: -72, concentration: 0.70, radiusDeg: 2.8 },
      { lon: 35, lat: -71, concentration: 0.60, radiusDeg: 2.2 },
      { lon: 55, lat: -70, concentration: 0.55, radiusDeg: 1.8 },
      { lon: 38, lat: -68, concentration: 0.50, radiusDeg: 2 },
      { lon: 52, lat: -74, concentration: 0.80, radiusDeg: 3 },
      { lon: 43, lat: -69.5, concentration: 0.65, radiusDeg: 2.5 },
    ]

    icePatches.forEach((patch) => {
      const numPoints = 32
      const coords: [number, number][] = []

      for (let i = 0; i <= numPoints; i++) {
        const angle = (i / numPoints) * 2 * Math.PI
        const r = patch.radiusDeg * (0.8 + Math.random() * 0.4) // irregular shape
        const patchLon = patch.lon + r * Math.cos(angle)
        const patchLat = patch.lat + r * Math.sin(angle)
        coords.push(fromLonLat([patchLon, patchLat], 'EPSG:3031') as [number, number])
      }

      const feature = new Feature({
        geometry: new Polygon([coords]),
      })

      const opacity = patch.concentration * 0.65
      const alpha = Math.round(opacity * 255).toString(16).padStart(2, '0')

      feature.setStyle(
        new Style({
          fill: new Fill({ color: `#d0eaff${alpha}` }),
          stroke: new Stroke({ color: `rgba(200, 235, 255, 0.3)`, width: 1 }),
        })
      )

      source.addFeature(feature)
    })
  }, [])

  const createOceanCurrents = useCallback(() => {
    const source = currentsSourceRef.current
    source.clear()

    // Generate ocean current arrows - denser grid
    for (let lon = 30; lon <= 60; lon += 3) {
      for (let lat = -75; lat >= -68; lat += 2.5) {
        // Simulate circular current pattern around Antarctica
        const centerLon = 45
        const centerLat = -71
        const dx = lon - centerLon
        const dy = lat - centerLat
        const angle = Math.atan2(dy, dx) + Math.PI / 2 // perpendicular for circulation

        const speed = 0.3 + Math.random() * 0.5
        const arrowLength = 0.8 * speed

        const startLon = lon
        const startLat = lat
        const endLon = lon + arrowLength * Math.cos(angle)
        const endLat = lat + arrowLength * Math.sin(angle)

        const coords = [
          fromLonLat([startLon, startLat], 'EPSG:3031'),
          fromLonLat([endLon, endLat], 'EPSG:3031'),
        ]

        const feature = new Feature({
          geometry: new LineString(coords as [number, number][]),
        })

        const radius = 4 + speed * 2

        feature.setStyle(
          new Style({
            stroke: new Stroke({
              color: 'rgba(200,220,240,0.35)',
              width: 1.5,
            }),
            // Arrow head would need custom rendering, simplified here
          })
        )

        source.addFeature(feature)

        // Add arrow head point
        const arrowHead = new Feature({
          geometry: new Point(fromLonLat([endLon, endLat], 'EPSG:3031')),
        })
        arrowHead.setStyle(
          new Style({
            image: new Circle({
              radius: radius,
              fill: new Fill({ color: 'rgba(200,220,240,0.4)' }),
            }),
          })
        )
        source.addFeature(arrowHead)
      }
    }
  }, [])

  const updateVessel = useCallback(() => {
    const source = vesselSourceRef.current
    source.clear()

    const feature = new Feature({
      geometry: new Point(fromLonLat([FAKE_VESSEL.longitude, FAKE_VESSEL.latitude], 'EPSG:3031')),
    })

    feature.setStyle(
      new Style({
        image: new Circle({
          radius: 11, fill: new Fill({ color: '#f5c518' }), stroke: new Stroke({ color: '#1a0e00', width: 2 }),
        }),
        text: new Text({
          text: '▲',
          font: '16px Arial',
          fill: new Fill({ color: '#ffffff' }),
          rotation: ((FAKE_VESSEL.heading * Math.PI) / 180) * -1,
        }),
      })
    )

    source.addFeature(feature)
  }, [])

  const updateRoutes = useCallback(() => {
    const source = routesSourceRef.current
    source.clear()

    FAKE_ROUTES.forEach((route) => {
      const coords = route.coordinates.map((c) => fromLonLat(c as [number, number], 'EPSG:3031'))
      const feature = new Feature({
        geometry: new LineString(coords),
      })

      const color = ROUTE_COLORS[route.type]
      const isSelected = route.type === selectedRoute
      const width = isSelected ? (route.type === 'FASTEST' ? 4.0 : 3.5) : (route.type === 'FASTEST' ? 2.5 : 2)
      const lineDash = route.type === 'FASTEST' ? undefined : route.type === 'SAFEST' ? [8, 5] : [5, 5]

      feature.setStyle(
        new Style({
          stroke: new Stroke({
            color: color,
            width: width,
            lineDash: lineDash,
          }),
        })
      )

      source.addFeature(feature)
    })
  }, [selectedRoute])

  const updateIcebergs = useCallback(() => {
    const source = icebergsSourceRef.current
    source.clear()

    FAKE_ICEBERGS.forEach((iceberg) => {
      const feature = new Feature({
        geometry: new Point(fromLonLat([iceberg.longitude, iceberg.latitude], 'EPSG:3031')),
      })

      const radiusMap: Record<string, number> = {
        LARGE: 9,
        MEDIUM: 7,
        SMALL: 5,
        UNCONFIRMED: 7,
      }

      const radius = radiusMap[iceberg.size] || 6
      const isUnconfirmed = iceberg.size === 'UNCONFIRMED'

      feature.setStyle(
        new Style({
          image: new Circle({
            radius: radius,
            fill: new Fill({ color: isUnconfirmed ? 'rgba(255,80,80,0.75)' : 'rgba(220,240,255,0.90)' }),
            stroke: new Stroke({
              color: isUnconfirmed ? 'rgba(255,80,80,1)' : '#ffffff', width: 1.5, lineDash: isUnconfirmed ? [3, 3] : undefined,
            }),
          }),
          text: new Text({
            text: `${iceberg.confidence}%`,
            font: '9px "Courier New", monospace',
            fill: new Fill({ color: '#ffffff' }),
            offsetY: -12,
          }),
        })
      )

      source.addFeature(feature)
    })
  }, [])

  const updateDangerZones = useCallback(() => {
    const source = dangerZonesSourceRef.current
    source.clear()

    FAKE_DANGER_ZONES.forEach((zone) => {
      const coords = zone.vertices.map((v) => fromLonLat([v.lon, v.lat], 'EPSG:3031'))
      const feature = new Feature({
        geometry: new Polygon([coords]),
      })

      const riskColors: Record<string, string> = {
        LOW: 'rgba(34, 197, 94, 0.3)',
        MEDIUM: 'rgba(249, 115, 22, 0.3)',
        HIGH: 'rgba(239, 68, 68, 0.3)',
        CRITICAL: 'rgba(127, 29, 29, 0.3)',
      }

      const fillColor = riskColors[zone.riskLevel] || riskColors.MEDIUM
      feature.setStyle(
        new Style({
          fill: new Fill({ color: fillColor }),
          stroke: new Stroke({ color: '#ff4444', width: 2 }),
          text: new Text({
            text: zone.name,
            font: '10px "Courier New", monospace',
            fill: new Fill({ color: '#ffffff' }),
          }),
        })
      )

      source.addFeature(feature)
    })
  }, [])

  useEffect(() => {
    if (!mapContainerRef.current) return

    const baseLayer = new TileLayer({
      source: new XYZ({
        url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
        attributions: 'Tiles © Esri',
      }),
    })

    
    const overlayRing = []
    for (let lon = -180; lon <= 180; lon += 10) overlayRing.push(fromLonLat([lon, -45], 'EPSG:3031'))
    for (let lon = 180; lon >= -180; lon -= 10) overlayRing.push(fromLonLat([lon, -90], 'EPSG:3031'))
    
    const darkOverlayLayer = new VectorLayer({
      source: new VectorSource({
        features: [
          new Feature({
            geometry: new Polygon([overlayRing]),
          })
        ]
      }),
      style: new Style({
        fill: new Fill({ color: 'rgba(5, 15, 30, 0.75)' })
      }),
      zIndex: 1
    })

    const iceLayer = new VectorLayer({ source: iceSourceRef.current, zIndex: 2 })
    const currentsLayer = new VectorLayer({ source: currentsSourceRef.current, zIndex: 3 })
    const gridLayer = new VectorLayer({ source: gridSourceRef.current })
    const labelsLayer = new VectorLayer({ source: labelsSourceRef.current })
    const dangerZonesLayer = new VectorLayer({ source: dangerZonesSourceRef.current })
    const routesLayer = new VectorLayer({ source: routesSourceRef.current })
    const icebergsLayer = new VectorLayer({ source: icebergsSourceRef.current })
    const vesselLayer = new VectorLayer({ source: vesselSourceRef.current })

    const map = new Map({
      target: mapContainerRef.current,
      layers: [baseLayer, darkOverlayLayer, iceLayer, currentsLayer, gridLayer, dangerZonesLayer, routesLayer, icebergsLayer, labelsLayer, vesselLayer],
      view: new View({
        projection: 'EPSG:3031',
        center: fromLonLat([0, -75], 'EPSG:3031'),
        zoom: 5,
      }),
    })

    mapRef.current = map

    createGridLines()
    createLabels()
    createIcePatches()
    createOceanCurrents()
    updateVessel()
    updateRoutes()
    updateIcebergs()
    updateDangerZones()

    return () => {
      map.setTarget(undefined)
    }
  }, [createGridLines, createLabels, createIcePatches, createOceanCurrents, updateVessel, updateRoutes, updateIcebergs, updateDangerZones])

  useEffect(() => {
    updateRoutes()
  }, [selectedRoute, updateRoutes])

  return (
    <div className={styles.mapWrapper}>
      <div className={styles.mapContainer} ref={mapContainerRef} />

      <div className={styles.offlineBadge}>⚡ LIVE CONNECTION ACTIVE</div>

      <div className={styles.compass}>
        <div>N</div>
        <div className={styles.compassArrow}></div>
      </div>

      <div className={styles.legend}>
        <div className={styles.legendRow}>
          <span className={styles.legendSwatchFastest}></span>
          <span>FASTEST</span>
        </div>
        <div className={styles.legendRow}>
          <span className={styles.legendSwatchSafest}></span>
          <span>SAFEST</span>
        </div>
        <div className={styles.legendRow}>
          <span className={styles.legendSwatchBalanced}></span>
          <span>BALANCED</span>
        </div>
      </div>
    </div>
  )
}

export default MapView